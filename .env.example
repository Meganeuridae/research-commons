# Required
# Generate a strong value with: openssl rand -hex 64
JWT_SECRET=

# Server
PORT=3020
NODE_ENV=development

# Data paths (defaults shown)
DATABASE_PATH=./data/research.db
SUBMISSIONS_PATH=./data/submissions
DATA_PATH=./data

# Discord import (optional — leave unset to disable)
DISCORD_API_URL=
DISCORD_API_TOKEN=

# Email / password reset (optional — leave RESEND_API_KEY unset to disable email)
RESEND_API_KEY=
FROM_EMAIL=noreply@resend.dev
APP_URL=http://localhost:5173
